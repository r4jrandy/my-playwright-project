{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "playwright"]
  },
  "include": ["tests/**/*.ts", "data/**/*.ts", "*.playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
